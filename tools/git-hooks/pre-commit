#!/bin/sh
# =====================================================================
# Pre-Commit-Hook: gdlint (GDScript) + SonarQube-Scan (Python/tools) vor
# jedem Commit. Aktiviert über:  git config core.hooksPath tools/git-hooks
# - gdlint-Findings          -> Commit wird abgebrochen
# - SonarQube-Gate rot       -> Commit wird abgebrochen
# - Sonar-Server offline     -> Warnung, Commit laeuft durch
# =====================================================================

# --- gdlint: nur die im Commit enthaltenen GDScript-Dateien pruefen ---
repo_root=$(git rev-parse --show-toplevel)
gd_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.gd$' || true)
if [ -n "$gd_files" ]; then
  echo "[gdlint] Pruefe geaenderte GDScript-Dateien ..."
  (cd "$repo_root/godot" && echo "$gd_files" | sed "s|^godot/||" | xargs py -m gdtoolkit.linter)
  if [ $? -ne 0 ]; then
    echo ""
    echo "[gdlint] FINDINGS - Commit abgebrochen. Konfiguration: godot/.gdlintrc"
    echo "[gdlint] Notausstieg (bewusst!): git commit --no-verify"
    exit 1
  fi
  echo "[gdlint] Sauber."
fi

# --- SonarQube (analysiert tools/-Python; GDScript uebernimmt gdlint oben) ---
status=$(curl -s -m 3 http://localhost:9000/api/system/status 2>/dev/null)
case "$status" in
  *'"UP"'*) ;;
  *)
    echo "[sonar] Server nicht erreichbar - Scan uebersprungen. Start: tools/sonar-server.ps1"
    exit 0
    ;;
esac

echo "[sonar] Analysiere vor dem Commit (Quality Gate) ..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/tools/sonar-analyze.ps1"
rc=$?
if [ $rc -ne 0 ]; then
  echo ""
  echo "[sonar] QUALITY GATE ROT - Commit abgebrochen."
  echo "[sonar] Findings: http://localhost:9000/dashboard?id=hollywood-manager"
  echo "[sonar] Notausstieg (bewusst!): git commit --no-verify"
  exit 1
fi
echo "[sonar] Quality Gate gruen."
exit 0
